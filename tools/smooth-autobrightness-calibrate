SENSOR_DESTINATION = "net.hadess.SensorProxy"
SENSOR_PATH = "/net/hadess/SensorProxy"
SENSOR_INTERFACE = "net.hadess.SensorProxy"
POWER_DESTINATION = "org.gnome.SettingsDaemon.Power"
POWER_PATH = "/org/gnome/SettingsDaemon/Power"
