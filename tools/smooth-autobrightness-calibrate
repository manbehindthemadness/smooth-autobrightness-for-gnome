PROPERTIES_INTERFACE = "org.freedesktop.DBus.Properties"
SERVICE = "smooth-autobrightness-for-gnome.service"


def isotonic_increasing(values: list[float], weights: list[int] | None = None) -> list[float]:
    """Least-squares monotonic fit using the pool-adjacent-violators algorithm."""
    if not values:
        return []
    if weights is None:
        weights = [1] * len(values)
    if len(values) != len(weights):
        raise ValueError("values and weights must have equal lengths")

    blocks: list[list[float | int]] = []
    for index, (value, weight) in enumerate(zip(values, weights, strict=True)):
        if weight <= 0:
            raise ValueError("weights must be positive")
        blocks.append([index, index, float(value), int(weight)])
        while len(blocks) >= 2 and blocks[-2][2] > blocks[-1][2]:
            right = blocks.pop()
            left = blocks.pop()
            combined_weight = int(left[3]) + int(right[3])
            combined_value = (
                float(left[2]) * int(left[3]) + float(right[2]) * int(right[3])
            ) / combined_weight
            blocks.append([int(left[0]), int(right[1]), combined_value, combined_weight])

    fitted = [0.0] * len(values)
    for start, end, value, _weight in blocks:
        for index in range(int(start), int(end) + 1):
            fitted[index] = float(value)
    return fitted


def locally_smoothed_response(levels: list[int], values: list[float]) -> list[float]:
    """Suppress sensor quantization while retaining the measured response shape."""
    if len(levels) != len(values):
        raise ValueError("levels and values must have equal lengths")
    if len(values) < 3:
        return list(values)

    radius = min(4, (len(values) - 1) // 2)
    smoothed = []
    for index, level in enumerate(levels):
        start = max(0, index - radius)
        end = min(len(values), index + radius + 1)
        xs = [float(value) for value in levels[start:end]]
        ys = values[start:end]
        mean_x = statistics.fmean(xs)
        mean_y = statistics.fmean(ys)
        variance = sum((value - mean_x) ** 2 for value in xs)
        slope = (
            sum((x - mean_x) * (y - mean_y) for x, y in zip(xs, ys, strict=True))
            / variance
            if variance > 0.0
            else 0.0
        )
        smoothed.append(mean_y + slope * (float(level) - mean_x))

    smoothed = isotonic_increasing(smoothed)
    source_range = values[-1] - values[0]
    smooth_range = smoothed[-1] - smoothed[0]
    if source_range > 0.0 and smooth_range > 0.0:
        smoothed = [
            values[0] + (value - smoothed[0]) * source_range / smooth_range
            for value in smoothed
        ]
    return smoothed


def perceptual_coordinates(
    commands_to_lux: list[float],
    commands_to_raw: list[int],
) -> tuple[list[float], dict[str, float]]:
    """Build a cadence coordinate that rapidly crosses conspicuous steps."""
    positive_steps = [
        right - left
        for left, right in zip(commands_to_lux, commands_to_lux[1:])
        if right > left
    ]
    resolution = statistics.median(positive_steps) if positive_steps else 1.0
    adaptation_floor = max(resolution / 2.0, 1e-6)
    salience = [
        max(0.0, math.log(
            (right + adaptation_floor) / (left + adaptation_floor)
        ))
        for left, right in zip(commands_to_lux, commands_to_lux[1:])
    ]
    reference_candidates = [
        value
        for command, value in enumerate(salience, start=1)
        if 50 <= command <= 90 and value > 0.0
    ]
    all_positive = [value for value in salience if value > 0.0]
    reference = statistics.median(reference_candidates or all_positive or [1.0])

    minimum_real_step = 0.20
    duplicate_step = 0.05
    coordinates = [0.0]
    for index, value in enumerate(salience, start=1):
        if commands_to_raw[index] == commands_to_raw[index - 1]:
            factor = duplicate_step
        elif value > 0.0:
            factor = max(minimum_real_step, min(1.0, reference / value))
        else:
            factor = 1.0
        coordinates.append(coordinates[-1] + factor)
    return coordinates, {
        "adaptation_floor_lux": adaptation_floor,
        "minimum_real_step_factor": minimum_real_step,
        "duplicate_step_factor": duplicate_step,
        "reference_log_step": reference,
    }


def refresh_perceptual_timing(profile: dict[str, object]) -> dict[str, object]:
    """Recompute timing metadata from a completed calibration sweep."""
    entries = list(profile.get("entries", []))
    if not entries:
        raise ValueError("profile contains no calibration entries")
    levels = [int(entry["raw_level"]) for entry in entries]
    fitted = [float(entry["fitted_lux"]) for entry in entries]
    smoothed = locally_smoothed_response(levels, fitted)
    baseline = float(profile.get("baseline_lux", fitted[0]))
    command_lux: list[float | None] = [None] * 101
    command_raw: list[int | None] = [None] * 101
    for index, entry in enumerate(entries):
        entry["smoothed_lux"] = smoothed[index]
        for command_value in entry["commands"]:
            command = int(command_value)
            if not 0 <= command <= 100 or command_lux[command] is not None:
                raise ValueError("profile contains invalid or duplicate commands")
            command_lux[command] = max(0.0, smoothed[index] - baseline)
            command_raw[command] = levels[index]
    if any(value is None for value in command_lux + command_raw):
        raise ValueError("profile does not cover every command from 0 through 100")
    coordinates, settings = perceptual_coordinates(
        [float(value) for value in command_lux],
        [int(value) for value in command_raw],
    )
    profile["perceptual_timing"] = {
        **settings,
        "command_coordinates": coordinates,
    }
    return profile


def default_output_path() -> Path:
    root = Path(os.environ.get("XDG_CONFIG_HOME", Path.home() / ".config"))
    return root / "smooth-autobrightness-for-gnome" / "display-calibration.json"


def read_int(path: Path) -> int | None:
    try:
        return int(path.read_text(encoding="ascii").strip())
    except (OSError, ValueError):
        return None


def discover_backlights() -> dict[str, dict[str, object]]:
    devices: dict[str, dict[str, object]] = {}
    for path in sorted(Path("/sys/class/backlight").glob("*")):
        maximum = read_int(path / "max_brightness")
        if maximum is None or maximum <= 0:
            continue
        devices[path.name] = {
            "path": str(path),
            "type": (path / "type").read_text(encoding="ascii").strip()
            if (path / "type").exists()
            else "unknown",
            "maximum": maximum,
        }
    return devices


def discover_als_keepalive() -> Path | None:
    for device in sorted(Path("/sys/bus/iio/devices").glob("iio:device*")):
        try:
            name = (device / "name").read_text(encoding="ascii").strip()
        except OSError:
            continue
        if name != "als":
            continue
        for candidate in ("in_illuminance_input", "in_illuminance_raw"):
            path = device / candidate
            if path.is_file():
                return path
    return None


def display_identity(backlights: dict[str, dict[str, object]]) -> dict[str, object]:
    edids = []
    for path in sorted(Path("/sys/class/drm").glob("*/edid")):
        try:
            data = path.read_bytes()
        except OSError:
            continue
        if data:
            edids.append(hashlib.sha256(data).hexdigest())
    return {
        "edid_sha256": edids,
        "backlights": {
            name: {key: value for key, value in details.items() if key != "path"}
            for name, details in backlights.items()
        },
    }


class DBusControls:
    def __init__(self) -> None:
        self.system = Gio.bus_get_sync(Gio.BusType.SYSTEM, None)
        self.session = Gio.bus_get_sync(Gio.BusType.SESSION, None)
        self.claimed = False

    @staticmethod
    def _unpack_variant(reply: GLib.Variant) -> object:
        value = reply.get_child_value(0).get_variant()
        return value.unpack()

    def get_property(
        self,
        connection: Gio.DBusConnection,
        destination: str,
        path: str,
        interface: str,
        name: str,
    ) -> object:
        reply = connection.call_sync(
            destination,
            path,
            PROPERTIES_INTERFACE,
            "Get",
            GLib.Variant("(ss)", (interface, name)),
            GLib.VariantType.new("(v)"),
            Gio.DBusCallFlags.NONE,
            3000,
            None,
        )
        return self._unpack_variant(reply)

    def claim_sensor(self) -> None:
        self.system.call_sync(
            SENSOR_DESTINATION,
            SENSOR_PATH,
            SENSOR_INTERFACE,
            "ClaimLight",
            None,
            None,
            Gio.DBusCallFlags.NONE,
            3000,
            None,
        )
        self.claimed = True

    def release_sensor(self) -> None:
        if not self.claimed:
            return
        try:
            self.system.call_sync(
                SENSOR_DESTINATION,
                SENSOR_PATH,
                SENSOR_INTERFACE,
                "ReleaseLight",
                None,
                None,
                Gio.DBusCallFlags.NONE,
                3000,
                None,
            )
        finally:
            self.claimed = False

    def light_level(self) -> float:
        return float(
            self.get_property(
                self.system,
                SENSOR_DESTINATION,
                SENSOR_PATH,
                SENSOR_INTERFACE,
                "LightLevel",
            )
        )

    def brightness(self) -> int:
        return int(
            self.get_property(
                self.session,
                POWER_DESTINATION,
                POWER_PATH,
                SCREEN_INTERFACE,
                "Brightness",
            )
        )

    def set_brightness(self, percentage: int) -> None:
        self.session.call_sync(
            POWER_DESTINATION,
            POWER_PATH,
            PROPERTIES_INTERFACE,
            "Set",
            GLib.Variant(
                "(ssv)",
                (SCREEN_INTERFACE, "Brightness", GLib.Variant("i", percentage)),
            ),
            None,
            Gio.DBusCallFlags.NONE,
            3000,
            None,
        )


def service_is_active() -> bool:
    return subprocess.run(
        ["systemctl", "--user", "is-active", "--quiet", SERVICE],
        check=False,
    ).returncode == 0


def service_action(action: str) -> None:
    subprocess.run(["systemctl", "--user", action, SERVICE], check=True)


def ambient_enabled() -> bool:
    result = subprocess.run(
        [
            "gsettings",
            "get",
            "org.gnome.settings-daemon.plugins.power",
            "ambient-enabled",
        ],
        check=True,
        text=True,
        stdout=subprocess.PIPE,
    )
    return result.stdout.strip() == "true"


def set_ambient_enabled(enabled: bool) -> None:
    subprocess.run(
        [
            "set",
            "org.gnome.settings-daemon.plugins.power",
            "ambient-enabled",
            "true" if enabled else "false",
        ],
        check=True,
    )


def choose_backlight(records: list[dict[str, object]]) -> str | None:
    names = {
        name
        for record in records
        for name in dict(record.get("raw_by_device", {})).keys()
    }
    if not names:
        return None
    return max(
        names,
        key=lambda name: len(
            {
                dict(record.get("raw_by_device", {})).get(name)
                for record in records
            }
        ),
    )


def build_profile(
    records: list[dict[str, object]],
    backlights: dict[str, dict[str, object]],
    settings: argparse.Namespace,
) -> dict[str, object]:
    selected = choose_backlight(records)
    grouped: dict[int, dict[str, object]] = {}
    for record in records:
        raw_values = dict(record["raw_by_device"])
        level = int(raw_values[selected]) if selected is not None else int(record["command"])
        group = grouped.setdefault(
            level,
            {"commands": set(), "ascending": [], "descending": []},
        )
        group["commands"].add(int(record["command"]))
        group[str(record["direction"])].append(float(record["lux"]))

    levels = sorted(grouped)
    measured = []
    weights = []
    for level in levels:
        samples = list(grouped[level]["ascending"]) + list(grouped[level]["descending"])
        measured.append(statistics.fmean(samples))
        weights.append(len(samples))
    fitted = isotonic_increasing(measured, weights)
    smoothed = locally_smoothed_response(levels, fitted)
    baseline = fitted[0] if fitted else 0.0
    fitted_range = fitted[-1] - baseline if fitted else 0.0

    entries = []
    for index, level in enumerate(levels):
        ascending = list(grouped[level]["ascending"])
        descending = list(grouped[level]["descending"])
        previous_lux = fitted[index - 1] if index > 0 else fitted[index]
        step_lux = max(0.0, fitted[index] - previous_lux)
        entries.append(
            {
                "raw_level": level,
                "commands": sorted(grouped[level]["commands"]),
                "ascending_lux": statistics.fmean(ascending) if ascending else None,
                "descending_lux": statistics.fmean(descending) if descending else None,
                "measured_lux": measured[index],
                "fitted_lux": fitted[index],
                "smoothed_lux": smoothed[index],
                "net_lux": max(0.0, fitted[index] - baseline),
                "step_lux": step_lux,
                "step_fraction_of_range": step_lux / fitted_range
                if fitted_range > 0.0
                else 0.0,
            }
        )

    command_lux = [0.0] * 101
    command_raw = [0] * 101
    for index, level in enumerate(levels):
        for command in grouped[level]["commands"]:
            command_lux[int(command)] = max(0.0, smoothed[index] - baseline)
            command_raw[int(command)] = level
    coordinates, perceptual_settings = perceptual_coordinates(command_lux, command_raw)

    return {
        "schema": 1,
        "created_utc": time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime()),
        "method": "fullscreen-white-mirror-reflection",
        "selected_backlight": selected,
        "identity": display_identity(backlights),
        "settings": {
            "settle_ms": settings.settle_ms,
            "samples": settings.samples,
            "sample_ms": settings.sample_ms,
        },
        "baseline_lux": baseline,
        "distinct_levels": len(entries),
        "perceptual_timing": {
            **perceptual_settings,
            "command_coordinates": coordinates,
        },
        "entries": entries,
    }


def atomic_write_json(path: Path, value: object) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    descriptor, temporary = tempfile.mkstemp(prefix=path.name + ".", dir=path.parent)
    try:
        with os.fdopen(descriptor, "w", encoding="utf-8") as stream:
            json.dump(value, stream, indent=2, sort_keys=True)
            stream.write("\n")
            stream.flush()
            os.fsync(stream.fileno())
        os.replace(temporary, path)
    except BaseException:
        try:
            os.unlink(temporary)
        except OSError:
            pass
        raise


class CalibrationWindow(Gtk.ApplicationWindow):
    def __init__(self, application: Gtk.Application, settings: argparse.Namespace) -> None:
        super().__init__(application=application, title="Display luminance calibration")
        self.settings = settings
        self.cancel = threading.Event()
        self.worker: threading.Thread | None = None
        self.inhibit_cookie = 0
        self.set_default_size(720, 420)

        provider = Gtk.CssProvider()
        provider.load_from_data(b"window, .calibration-white { background: #ffffff; }")
        Gtk.StyleContext.add_provider_for_display(
            Gdk.Display.get_default(),
            provider,
            Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION,
        )

        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=18)
        box.set_margin_top(32)
        box.set_margin_bottom(32)
        box.set_margin_start(40)
        box.set_margin_end(40)
        label = Gtk.Label(
            label=(
                "Place the computer in a fully dark room facing a mirror.\n\n"
                "The display and ambient-light sensor must both face the mirror. "
                "Keep the lid, mirror, and computer stationary throughout the sweep.\n\n"
                "The test takes about 2–3 minutes. Escape cancels safely."
            )
        )
        label.set_wrap(True)
        label.set_justify(Gtk.Justification.CENTER)
        button = Gtk.Button(label="Begin calibration")
        button.connect("clicked", self._begin)
        box.append(label)
        box.append(button)
        self.set_child(box)

        keys = Gtk.EventControllerKey()
        keys.connect("key-pressed", self._key_pressed)
        self.add_controller(keys)
        self.connect("close-request", self._close_requested)

    def _key_pressed(self, _controller, keyval, _keycode, _state) -> bool:
        if keyval == Gdk.KEY_Escape:
            self.cancel.set()
            return True
        return False

    def _close_requested(self, _window) -> bool:
        if self.worker is not None and self.worker.is_alive():
            self.cancel.set()
            return True
        return False

    def _begin(self, _button) -> None:
        self.fullscreen()
        white = Gtk.Box()
        white.add_css_class("calibration-white")
        self.set_child(white)
        self.inhibit_cookie = self.get_application().inhibit(
            self,
            Gtk.ApplicationInhibitFlags.IDLE,
            "Display luminance calibration",
        )
        self.worker = threading.Thread(target=self._run_calibration, daemon=True)
        self.worker.start()

    def _read_raw(self, backlights: dict[str, dict[str, object]]) -> dict[str, int]:
        result = {}
        for name, details in backlights.items():
            value = read_int(Path(str(details["path"])) / "brightness")
            if value is not None:
                result[name] = value
        return result

    def _run_calibration(self) -> None:
        controls: DBusControls | None = None
        original_brightness: int | None = None
        restart_service = False
        restore_ambient = False
        error: str | None = None
        output: Path | None = None
        try:
            time.sleep(0.5)
            restart_service = service_is_active()
            if restart_service:
                service_action("stop")
            restore_ambient = ambient_enabled()
            if restore_ambient:
                set_ambient_enabled(False)

            controls = DBusControls()
            original_brightness = controls.brightness()
            controls.claim_sensor()
            backlights = discover_backlights()
            keepalive = discover_als_keepalive()
            records: list[dict[str, object]] = []
            sequence = [("ascending", value) for value in range(101)]
            sequence.extend(("descending", value) for value in range(99, -1, -1))

            for index, (direction, command) in enumerate(sequence, start=1):
                if self.cancel.is_set():
                    raise InterruptedError("calibration cancelled")
                controls.set_brightness(command)
                time.sleep(self.settings.settle_ms / 1000.0)
                samples = []
                raw_samples = []
                for _ in range(self.settings.samples):
                    if self.cancel.is_set():
                        raise InterruptedError("calibration cancelled")
                    if keepalive is not None:
                        try:
                            keepalive.read_text(encoding="ascii")
                        except OSError:
                            pass
                    time.sleep(self.settings.sample_ms / 1000.0)
                    samples.append(controls.light_level())
                    raw_samples.append(self._read_raw(backlights))
                raw_by_device = {
                    name: int(statistics.median(
                        sample[name] for sample in raw_samples if name in sample
                    ))
                    for name in backlights
                    if any(name in sample for sample in raw_samples)
                }
                records.append(
                    {
                        "direction": direction,
                        "command": command,
                        "lux": statistics.median(samples),
                        "raw_by_device": raw_by_device,
                    }
                )
                print(
                    f"[{index:3d}/{len(sequence)}] {direction:10s} "
                    f"command={command:3d}% raw={raw_by_device} "
                    f"lux={statistics.median(samples):.3f}",
                    flush=True,
                )

            profile = build_profile(records, backlights, self.settings)
            output = self.settings.output
            atomic_write_json(output, profile)
        except InterruptedError as exception:
            error = str(exception)
        except BaseException as exception:  # restoration must run for D-Bus/IO failures
            error = f"{type(exception).__name__}: {exception}"
        finally:
            if controls is not None:
                if original_brightness is not None:
                    try:
                        controls.set_brightness(original_brightness)
                    except BaseException as exception:
                        error = error or f"unable to restore brightness: {exception}"
                try:
                    controls.release_sensor()
                except BaseException as exception:
                    error = error or f"unable to release sensor: {exception}"
            if restore_ambient:
                try:
                    set_ambient_enabled(True)
                except BaseException as exception:
                    error = error or f"unable to restore GNOME ambient setting: {exception}"
            if restart_service:
                try:
                    service_action("start")
                except BaseException as exception:
                    error = error or f"unable to restart service: {exception}"
            GLib.idle_add(self._finish, output, error)

    def _finish(self, output: Path | None, error: str | None) -> bool:
        if self.inhibit_cookie:
            self.get_application().uninhibit(self.inhibit_cookie)
            self.inhibit_cookie = 0
        self.unfullscreen()
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=18)
        box.set_margin_top(32)
        box.set_margin_bottom(32)
        box.set_margin_start(40)
        box.set_margin_end(40)
        if error is None and output is not None:
            message = f"Calibration complete.\n\nProfile written to:\n{output}"
        else:
            message = f"Calibration stopped.\n\n{error or 'unknown error'}"
        label = Gtk.Label(label=message)
        label.set_wrap(True)
        label.set_selectable(True)
        button = Gtk.Button(label="Close")
        button.connect("clicked", lambda _button: self.close())
        box.append(label)
        box.append(button)
        self.set_child(box)
        return GLib.SOURCE_REMOVE


class CalibrationApplication(Gtk.Application):
    def __init__(self, settings: argparse.Namespace) -> None:
        super().__init__(application_id="org.manbehindthemadness.SmoothAutobrightness.Calibrate")
        self.settings = settings

    def do_activate(self) -> None:
        window = self.props.active_window
        if window is None:
            window = CalibrationWindow(self, self.settings)
        window.present()


def check_environment() -> int:
    controls = DBusControls()
    print(f"GNOME brightness: {controls.brightness()}%")
    print(f"SensorProxy light level: {controls.light_level():.3f} lux")
    backlights = discover_backlights()
    if not backlights:
        print("Backlight devices: none", file=sys.stderr)
        return 1
    for name, details in backlights.items():
        current = read_int(Path(str(details["path"])) / "brightness")
        print(
            f"Backlight {name}: raw={current}/{details['maximum']} "
            f"type={details['type']}"
        )
    keepalive = discover_als_keepalive()
    print(f"ALS keepalive: {keepalive if keepalive is not None else 'not required/found'}")
    return 0


def parse_arguments() -> argparse.Namespace:
    parser = argparse.ArgumentParser(
        description="Calibrate display backlight luminance using mirror-reflected ALS readings."
    )
    parser.add_argument("--check", action="store_true", help="verify interfaces without changing brightness")
    parser.add_argument(
        "--refresh-profile",
        action="store_true",
        help="recompute timing metadata in an existing profile without another sweep",
    )
    parser.add_argument("--output", type=Path, default=default_output_path())
    parser.add_argument("--settle-ms", type=int, default=250)
    parser.add_argument("--samples", type=int, default=3)
    parser.add_argument("--sample-ms", type=int, default=150)
    settings = parser.parse_args()
    if settings.settle_ms < 50 or settings.samples < 1 or settings.sample_ms < 50:
        parser.error("settle/sample intervals must be at least 50 ms and samples at least 1")
    return settings


def main() -> int:
    settings = parse_arguments()
    if settings.check:
        return check_environment()
    if settings.refresh_profile:
        with settings.output.open(encoding="utf-8") as stream:
            profile = json.load(stream)
        atomic_write_json(settings.output, refresh_perceptual_timing(profile))
        print(f"Refreshed perceptual timing in {settings.output}")
        return 0
    application = CalibrationApplication(settings)

    def cancel_from_signal(_signum, _frame) -> None:
        window = application.props.active_window
        if (
            isinstance(window, CalibrationWindow)
            and window.worker is not None
            and window.worker.is_alive()
        ):
            window.cancel.set()
        else:
            application.quit()

    signal.signal(signal.SIGINT, cancel_from_signal)
    signal.signal(signal.SIGTERM, cancel_from_signal)
    return application.run([sys.argv[0]])


if __name__ == "__main__":
    raise SystemExit(main())
