[Unit]
Description=Smooth GNOME automatic brightness transitions
Documentation=https://github.com/manbehindthemadness/smooth-autobrightness-for-gnome
After=graphical-session.target
PartOf=graphical-session.target

[Service]
Type=simple
Environment=SABG_OPTIONS=
ExecStart=/usr/local/bin/smooth-autobrightness-for-gnome $SABG_OPTIONS
Restart=on-failure
RestartSec=2
Nice=0
CPUWeight=200
CPUQuota=5%
CPUQuotaPeriodSec=100ms
MemoryMax=32M
TasksMax=4
IOWeight=10
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
BindReadOnlyPaths=-%h/.config/smooth-autobrightness-for-gnome/display-calibration.json
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX
RestrictRealtime=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes

[Install]
WantedBy=graphical-session.target
